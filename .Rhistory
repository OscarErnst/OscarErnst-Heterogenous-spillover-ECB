# Indlæs pakker
library(httr)
library(jsonlite)
library(dplyr)
library(sf)
library(tidyr)
################################################################################
#                      HENT DATA FRA DATAFORSYNINGEN
################################################################################
url <- "https://api.dataforsyningen.dk/kommuner"
response <- GET(url, add_headers(Accept = "application/json"))
if (status_code(response) == 200) {
data_raw <- fromJSON(content(response, "text"), flatten = TRUE)
kommuner_df <- as.data.frame(data_raw)
remove(response, data_raw)
} else {
stop("Fejl ved hentning af data - status code: ", status_code(response))
}
################################################################################
#                      RENS OG OMDØB KOLONNER
################################################################################
kommuner_df <- kommuner_df %>%
select(navn, bbox) %>%
rename(Kommune = navn) %>%
unnest_wider(bbox, names_sep = "_") %>%
rename(
xmin = bbox_1,
ymin = bbox_2,
xmax = bbox_3,
ymax = bbox_4
)
################################################################################
#                      OMDAN TIL SF-POLYGONER
################################################################################
kommuner_df_sf <- kommuner_df %>%
rowwise() %>%
mutate(
geometry = st_sfc(
st_polygon(list(
matrix(c(
xmin, ymin,
xmin, ymax,
xmax, ymax,
xmax, ymin,
xmin, ymin
), ncol = 2, byrow = TRUE)
)),
crs = 25832
)
) %>%
ungroup() %>%
st_as_sf()
################################################################################
#                      GEM SOM RDS
################################################################################
rds_output <- "Data/Kommune_polygoner.rds"
saveRDS(kommuner_df_sf, file = rds_output)
View(kommuner_df_sf)
rds_output <- "I:/Dream/Projects/2024/BVC/SNI/API/Data/Kommune_koordinater.rds"
saveRDS(kommuner_df_sf, file = rds_output)
message("Kommunepolygoner gemt som .rds.")
