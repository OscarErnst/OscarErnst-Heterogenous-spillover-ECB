get_country_label <- function(code) {
if (code %in% names(country_names)) {
return(country_names[code])
} else {
return(code)  # fallback
}
}
# 6) Outcome variable and additional controls
#    We'll assume we need both "d_rGDP" AND "bund_yield"
#    in the model so we can do the same scaling trick (bund_yield(0) = +1).
outcome_vars <- c("d_rGDP", "bund_yield")
# 7) Create a PNG for the multi-panel plot.
#    We'll do 7 rows × 3 columns = 21 subplots, which matches your 21 countries.
png("Graphs/LP-IV/AllCountries_rGDP.png", width = 3200, height = 4200, res = 300)
par(mfrow = c(7, 3),
mar = c(4, 4, 2, 1),
cex.axis = 0.8,
cex.lab  = 0.8,
cex.main = 1.0)
# Define the burgundy colors used in your existing scripts
burgundy       <- "#760020"
burgundy_trans <- rgb(118/255, 0, 32/255, alpha = 0.3)
# 8) Loop over countries
for (ctry in countries) {
# --- (a) Subset to this country
df_ctry <- full_data %>%
filter(country == ctry) %>%
dplyr::select(all_of(outcome_vars))
# We also need the same rows of the shock:
# (Assuming shock_all is the same length & times as full_data; adapt if needed!)
# If the "shock_all" is exactly the same for each row, you might just do:
#   ctry_shock <- shock_all
# Or if your data is in a big long panel, you might merge by date.
# For simplicity, let's assume we have them aligned row-by-row:
ctry_shock <- shock_all[full_data$country == ctry]
# Combine for NA-omission
tmp <- na.omit( cbind(df_ctry, shock = ctry_shock) )
Y     <- tmp[, outcome_vars]       # 2 columns: "d_rGDP", "bund_yield"
shock <- tmp[, "shock", drop=FALSE]
# --- (b) Run LP-IV with the default settings
#     (Feel free to change lags, horizons, NW, etc. as you see fit.)
lpiv_res <- lp_lin_iv(
endog_data     = Y,
shock          = shock,
use_twosls     = FALSE,
lags_endog_lin = NaN,
trend          = 0,
confint        = 1.70,    # ~95% CI
use_nw         = TRUE,
lags_criterion = "AIC",
max_lags       = 9,
hor            = 8
)
# --- (c) Scale so that bund_yield(0) == +1
# 1) Find row of "bund_yield" in the IRF arrays
shockpos <- match("bund_yield", outcome_vars)
impact_original <- lpiv_res$irf_lin_mean[shockpos, 1]  # horizon=0
scaling <- 1 / impact_original
lpiv_res$irf_lin_mean <- lpiv_res$irf_lin_mean * scaling
lpiv_res$irf_lin_low  <- lpiv_res$irf_lin_low  * scaling
lpiv_res$irf_lin_up   <- lpiv_res$irf_lin_up   * scaling
# --- (d) Now extract the IRF for "d_rGDP" only:
rgdp_pos <- match("d_rGDP", outcome_vars)
rgdp_irf    <- lpiv_res$irf_lin_mean[rgdp_pos, ]
rgdp_lower  <- lpiv_res$irf_lin_low[rgdp_pos, ]
rgdp_upper  <- lpiv_res$irf_lin_up[rgdp_pos, ]
# We'll plot horizons from 0..(n-1)
horizons <- 0:(length(rgdp_irf) - 1)
# Determine y-limits
y_min <- min(rgdp_lower, na.rm=TRUE)
y_max <- max(rgdp_upper, na.rm=TRUE)
# Country label
ctry_label <- get_country_label(ctry)
# --- (e) Plot
plot(horizons, rgdp_irf,
type = "n",
ylim = c(y_min, y_max),
xlab = "Horizon (quarters)",
ylab = "Impulse Response: d_rGDP",
main = ctry_label)
abline(h = 0, lty = 2, col = "black")
# Confidence band polygon
polygon(
x = c(horizons, rev(horizons)),
y = c(rgdp_lower, rev(rgdp_upper)),
col = burgundy_trans, border = NA
)
# IRF line
lines(horizons, rgdp_irf, type = "b", col = burgundy, lwd = 2, pch = 16)
}
