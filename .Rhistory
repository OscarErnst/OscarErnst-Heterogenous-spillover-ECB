pointsize <- 0.3
plot(
st_geometry(sni_sf),
col = sni_sf$color,  # fractile-baseret farve
pch = 16,
cex = pointsize,
add = TRUE
)
# (c) VEJ-LAG
plot(geoData$road.motorway,    col = "white", lwd = 1,    add = TRUE)
plot(geoData$road.primary,     col = "white", lwd = 0.5,  add = TRUE)
plot(geoData$road.secondary,   col = "white", lwd = 0.1,  add = TRUE)
plot(geoData$road.tertiary,    col = "white", lwd = 0.1,  add = TRUE)
plot(geoData$road.residential, col = "white", lwd = 0.05, add = TRUE)
end_plot <- Sys.time()
message("Time for plotting layers + points: ",
round(difftime(end_plot, start_plot, units = "secs"), 3), " secs")
##############################################################################
#                (6) Luk PNG-enhed og returnér
##############################################################################
dev.off()
message("Plot gemt som: ", file_name)
end_total <- Sys.time()
message("Total time for `plot_by_sni()`: ",
round(difftime(end_total, start_total, units = "secs"), 3), " secs\n")
return(invisible(sni_sf))
}
