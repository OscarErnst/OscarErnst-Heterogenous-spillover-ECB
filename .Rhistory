# 2) Indlæs by-polygoner (allerede forarbejdet i EPSG:25832)
byer_df_sf <- readRDS("I:/Dream/Projects/2024/BVC/SNI/API/Data/By_koordinater.rds")
#-------------------------------------------------------------------------------
# Plumber-endpoint: Tegner SNI-plot som PNG
#-------------------------------------------------------------------------------
#' Returnerer SNI-plot direkte som PNG
#' @param password Password (kræves til godkendelse)
#' @param By Navn(e) på by(er), fx "København" eller "Skagen,Hirtshals,Hjørring"
#' @param year År, fx 2022
#' @get /sni/plot
#' @serializer png
function(password, By="København", year=2022) {
# Evt. passwordtjek
if(is.null(password) || password != "1234"){
stop("Forkert password - adgang nægtet.")
}
# Hvis brugeren vil have flere byer, fx "København,Helsingør"
By_vec <- unlist(strsplit(By, ","))
# Start timing
start_total <- Sys.time()
# (A) Tjek for gyldige byer og lav union bounding box
if (!all(By_vec %in% byer_df_sf$By)) {
missing_byes <- setdiff(By_vec, byer_df_sf$By)
stop("Følgende by(er) findes ikke i byer_df_sf: ", paste(missing_byes, collapse = ", "))
}
by_poly <- byer_df_sf %>%
filter(By %in% !!By_vec)
bbox_multi <- st_bbox(by_poly)
# (B) Læs SNI-data og filtrér inden for bounding box
sni_data <- readRDS(
paste0("I:/Dream/Projects/2024/BVC/SNI/API/Data/SNI_", year, ".rds")
)
sni_subset <- sni_data %>%
filter(
KOORNORD >= bbox_multi$xmin & KOORNORD <= bbox_multi$xmax,
KOOROEST >= bbox_multi$ymin & KOOROEST <= bbox_multi$ymax
)
if(nrow(sni_subset) == 0){
stop("Ingen SNI-observationer indenfor bounding box for det valgte år.")
}
# (C) Konverter til sf
sni_sf <- st_as_sf(
sni_subset,
coords = c("KOORNORD", "KOOROEST"),
crs = 25832
)
# (D) Plot i base R (Plumber håndterer PNG-device pga. @serializer png)
xlim_range <- c(bbox_multi$xmin, bbox_multi$xmax)
ylim_range <- c(bbox_multi$ymin, bbox_multi$ymax)
par(mar = c(0, 0, 0, 0))  # Ingen margener
# Plot landmasse
plot(
geoData$landmass,
border = "gray95",
col    = "gray95",
xlim   = xlim_range,
ylim   = ylim_range
)
# Plot SNI-punkter
pointsize <- 0.3
plot(
st_geometry(sni_sf),
col = sni_sf$color,
pch = 16,
cex = pointsize,
add = TRUE
)
# Plot vej-lag
plot(geoData$road.motorway,    col = "white", lwd = 1,    add = TRUE)
plot(geoData$road.primary,     col = "white", lwd = 0.5,  add = TRUE)
plot(geoData$road.secondary,   col = "white", lwd = 0.1,  add = TRUE)
plot(geoData$road.tertiary,    col = "white", lwd = 0.1,  add = TRUE)
plot(geoData$road.residential, col = "white", lwd = 0.05, add = TRUE)
# Slut tid
end_total <- Sys.time()
message("Total time for plotting: ",
round(difftime(end_total, start_total, units = "secs"), 3), " secs\n")
# Ingen dev.off() - Plumber klarer at sende PNG-output
return(invisible(TRUE))
}
