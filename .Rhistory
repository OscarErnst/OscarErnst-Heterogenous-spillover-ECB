# ─────────────────────────────────────────────────────────────────────────
# 1. Load libraries
# ─────────────────────────────────────────────────────────────────────────
library(dplyr)
library(lpirfs)
library(broom)
# ─────────────────────────────────────────────────────────────────────────
# 2. Load data
# ─────────────────────────────────────────────────────────────────────────
data <- readRDS("Data/Panel LP-IV/panel_input_data.rds")
# ─────────────────────────────────────────────────────────────────────────
# 3. Create country dummies and interaction terms
# ─────────────────────────────────────────────────────────────────────────
countries <- c(
"AT", "BE", "CY", "DK", "EE", "EA20", "FI", "FR", "DE",
"EL", "IE", "IT", "LV", "LT", "LU", "MT", "NL", "PT",
"SK", "SI", "ES"
)
# Add interaction terms: shock * dummy
for (ctry in countries) {
varname <- paste0("shock_", ctry)
data[[varname]] <- data$shock * ifelse(data$country == ctry, 1, 0)
}
# ─────────────────────────────────────────────────────────────────────────
# 4. Run panel LP with all interactions
# ─────────────────────────────────────────────────────────────────────────
shock_vars <- paste0("shock_", countries)
results_panel_het <- lp_lin_panel(
data_set       = data,
endog_data     = "d_rGDP",
shock          = shock_vars,
diff_shock     = FALSE,
iv_reg         = FALSE,
c_exog_data    = c("d_HICP", "bund_yield"),
l_exog_data    = c("d_rGDP", "d_HICP", "bund_yield"),
lags_exog_data = 4,
hor            = 9,
cumul_mult     = TRUE,
robust_cov     = "vcovSCC",
panel_model    = "within",
panel_effect   = "individual",
confint        = 1.96
)
