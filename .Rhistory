# Load libraries
library(lpirfs)
library(dplyr)
# Load dataset
data <- readRDS("Data/Panel LP-IV/panel_input_data.rds") %>%
arrange(country, Date)
# Define key variables
endog_var <- "d_rGDP"    # Can run separately for "d_HICP" or "bund_yield"
shock_var <- "shock"     # Already instrumented externally
lags <- 4
horizon <- 8
# Run Panel LP-IV (shock already externally instrumented)
results_panel_iv <- lp_lin_panel(
data_set      = data,
data_sample   = "Full",
endog_data    = endog_var,      # one endogenous variable at a time
cumul_mult    = F,           # cumulative IRF (or FALSE if not)
shock         = shock_var,
diff_shock    = FALSE,          # already differenced externally
iv_reg        = FALSE,          # FALSE: shock externally instrumented
panel_model   = "within",
panel_effect  = "individual",
robust_cov    = "vcovSCC",
robust_maxlag = NULL,
c_exog_data   = c("d_HICP", "bund_yield"),  # contemporaneous controls
l_exog_data   = c("d_rGDP", "d_HICP", "bund_yield"),  # lagged controls
lags_exog_data = lags,          # number of lags for controls
hor           = horizon,
confint       = 1.96
)
# Summary and plots
summary(results_panel_iv)
plot(results_panel_iv)
