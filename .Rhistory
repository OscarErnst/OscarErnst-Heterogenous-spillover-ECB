)
plot_irfs_panel <- function(irf_summary_list, variable_name = "IRF") {
par(mfrow = c(3, 3), mar = c(4, 4, 2, 1), oma = c(0, 0, 2, 0))
countries <- names(irf_summary_list[["h0"]]$IRF_mean)
horizon <- seq_along(irf_summary_list) - 1
for (country in countries) {
means  <- sapply(irf_summary_list, function(x) x$IRF_mean[country])
lowers <- sapply(irf_summary_list, function(x) x$IRF_lower[country])
uppers <- sapply(irf_summary_list, function(x) x$IRF_upper[country])
ylim <- range(c(lowers, uppers), na.rm = TRUE)
plot(horizon, means, type = "n", ylim = ylim,
main = country, xlab = "Horizon", ylab = variable_name)
polygon(c(horizon, rev(horizon)), c(lowers, rev(uppers)),
col = rgb(0.7, 0, 0, 0.2), border = NA)
lines(horizon, means, col = "#760020", lwd = 2, type = "b", pch = 16)
abline(h = 0, lty = 2)
grid()
}
}
plot_irfs_panel(Panel_LP_IV_results_GDP$IRF_summary)
plot_irfs_panel(Panel_LP_IV_results_HICP$IRF_summary)
