# -------------------------------------------------------------
# Funktion, der hjælper med at nedbringe store landuse-lag
# (her henter du kun "største" 98% for at undgå store mængder data)
# -------------------------------------------------------------
getbiggest <- function(x, lowerFrac, upperFrac) {
# 1) Beregn arealet af hvert polygon
areas <- st_area(x)
# 2) Sortér i faldende rækkefølge efter areal
sorted <- x[order(areas, decreasing = TRUE), ]
# 3) Udregn rækker til "bund" (lowerFrac) og "top" (upperFrac)
n <- nrow(sorted)
lower <- as.integer(lowerFrac * n)
upper <- as.integer(upperFrac * n)
# 4) Sikrer, at vi forbliver inden for gyldige indeks
if (lower < 1)      lower <- 1
if (upper > n)      upper <- n
if (lower > upper)  stop("Intervallet er tomt. Tjek dine fraktioner.")
# 5) Returnér det ønskede interval
sorted[lower:upper, ]
}
big_forest   <- getbiggest(geoData$landuse.green, 0, 0.98)
big_park     <- getbiggest(geoData$landuse.park,  0, 0.98)
big_gray     <- getbiggest(geoData$landuse.gray,  0, 0.98)
big_water    <- getbiggest(geoData$water.water,   0, 0.98)
big_wetlands <- getbiggest(geoData$water.wetland, 0, 0.98)
################################################################################
#                      HJÆLPEFUNKTIONER
################################################################################
## (A) Konverter danske bogstaver til alternativer (fx "Århus" -> "Aarhus")
replace_danish_letters <- function(x) {
x <- gsub("Å", "Aa", x, ignore.case = FALSE)
x <- gsub("å", "aa", x, ignore.case = FALSE)
x <- gsub("Æ", "Ae", x, ignore.case = FALSE)
x <- gsub("æ", "ae", ignore.case = FALSE)
x <- gsub("Ø", "Oe", x, ignore.case = FALSE)
x <- gsub("ø", "oe", ignore.case = FALSE)
return(x)
}
## (B) Funktion til at finde mulige forslag (bruges evt. i din API endpoints)
find_suggestions <- function(query, choices, max_suggestions = 5) {
matches <- choices[grepl(query, choices, ignore.case = TRUE)]
if (length(matches) > max_suggestions) {
matches <- matches[1:max_suggestions]
}
return(matches)
}
## (C) Tjek, om en given by eller postnummer kan rettes til en alternativ version
try_substitute <- function(query, choices) {
if (query %in% choices) {
return(query)
}
query_sub <- replace_danish_letters(query)
if (query_sub %in% choices) {
return(query_sub)
}
return(query)
}
# -------------------------------------------------------------
# Funktion, der beregner rektanglets areal (Bounding Box) i km²
# (Ikke ægte polygon-areal)
# -------------------------------------------------------------
calculate_bbox_area_km2 <- function(sni_subset) {
sni_bbox <- st_bbox(sni_subset)
width_m  <- sni_bbox$xmax - sni_bbox$xmin
height_m <- sni_bbox$ymax - sni_bbox$ymin
area_m2  <- width_m * height_m
area_km2 <- as.numeric(area_m2 / 1e6)
return(area_km2)
}
