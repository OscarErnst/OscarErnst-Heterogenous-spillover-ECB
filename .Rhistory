library(dplyr)
library(fixest)  # For panel regressions with Driscoll-Kraay SEs
horizon   <- 8
lags      <- 2
countries <- c("DE","FR","NL","DK","AT","IT","ES","PT","EL")
baseline  <- "DE"
others    <- setdiff(countries, baseline)
# Load data
data <- readRDS("Data/Panel LP-IV/panel_input_data.rds") %>%
arrange(country, Date)
# Interaction terms
for(c in others) {
data[[paste0("shock_", c)]] <- ifelse(data$country==c, data$shock, 0)
}
run_manual_lpiv <- function(data, outcome_var, horizon, lags, baseline, others){
library(fixest)
results_list <- list()
for(h in 0:(horizon-1)){
cat("Estimating horizon:", h, "\n")
# Construct dependent variable (cumulative change)
data <- data %>%
group_by(country) %>%
arrange(Date) %>%
mutate(y_lead = lead(get(outcome_var), h),
y_cum_diff = y_lead - lag(get(outcome_var), 1)) %>%
ungroup()
# Lagged controls
for(l in 1:lags){
data <- data %>%
group_by(country) %>%
mutate(!!paste0("lag_", outcome_var, "_", l) := lag(get(outcome_var), l)) %>%
ungroup()
}
# Model formula
controls <- paste(paste0("lag_", outcome_var, "_", 1:lags), collapse=" + ")
interactions <- paste0("shock_", others, collapse=" + ")
formula_str <- paste0("y_cum_diff ~ shock + ", interactions, " + ", controls, " | Date")
# IV formula (first stage implicitly assumed completed: instrument = "shock")
# Thus, no explicit IV here if shock is already instrumented
# Run regression with Driscoll-Kraay standard errors
reg <- feols(as.formula(formula_str), data=data, panel.id=c("country","Date"), vcov="DK")
results_list[[paste0("h",h)]] <- reg
}
return(results_list)
}
results_rGDP <- run_manual_lpiv(data, "d_rGDP", horizon, lags, baseline, others)
