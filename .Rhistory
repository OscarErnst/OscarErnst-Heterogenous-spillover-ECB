# 3) Load data (ADAPT THESE PATHS!)
#    We assume your data frame has a column "country", plus the variables:
#      - "d_rGDP"        (the outcome)
#      - "bund_yield"    (the yield for that country)
#      - Possibly more (HICP, consumption, etc.) if you need them
full_data   <- readRDS("Data/LP-IV/Kun PureMP/input_data.rds")
#    Load the single policy shock (PureMP).
#    If it's a single column that applies to all countries, we'll merge later.
shock_all <- readRDS("Data/LP-IV/Kun PureMP/PureMP_shock.rds")
# 4) Define the set of countries (as you did before)
countries <- c("AT", "BE", "CY", "DE", "DK", "EA20", "EE", "EL", "ES", "FI",
"FR", "IE", "IT", "LT", "LU", "LV", "MT", "NL", "PT", "SI", "SK")
countries <- "EA20"
# 5) (Optional) Nice display names:
country_names <- c(
"AT"   = "Austria",
"BE"   = "Belgium",
"CY"   = "Cyprus",
"DE"   = "Germany",
"DK"   = "Denmark",
"EA20" = "Euro Area (20)",
"EE"   = "Estonia",
"EL"   = "Greece",
"ES"   = "Spain",
"FI"   = "Finland",
"FR"   = "France",
"IE"   = "Ireland",
"IT"   = "Italy",
"LT"   = "Lithuania",
"LU"   = "Luxembourg",
"LV"   = "Latvia",
